<% content_for :title, "CSVアップロード" %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <%= render "shared/page_header",
               title: "CSVファイルのアップロード",
               subtitle: "ファイルを選択すると、プレビュー画面で加工を始められます。" %>

    <div class="csv-upload-page">
      <%= render "csv_files/upload_form" %>
    </div>

    <p class="csv-upload-page-note">
      対応文字コード: <%= csv_supported_input_encodings_label %>。
      <%= csv_max_file_size_label %>を超えるファイルはアップロードできません。
      加工完了後は、速やかにダウンロードしてください。
    </p>
  </div>
</div>
