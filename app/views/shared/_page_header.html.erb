<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 csv-page-header">
  <div>
    <h1 class="h3 mb-1"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="text-muted mb-0"><%= subtitle %></p>
    <% end %>
  </div>
  <% if local_assigns[:actions].present? %>
    <div class="csv-page-actions">
      <%= actions %>
    </div>
  <% end %>
</div>
