<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= app_title(content_for(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100"
        data-controller="posthog"
        data-posthog-enabled-value="<%= posthog_enabled? %>"
        data-posthog-api-key-value="<%= posthog_enabled? ? posthog_api_key : "" %>"
        data-posthog-api-host-value="<%= posthog_api_host %>"
        data-posthog-distinct-id-value="<%= posthog_distinct_id %>">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <%= link_to app_name, root_path, class: "navbar-brand mb-0 h1 text-decoration-none text-white" %>
      </div>
    </nav>

    <main class="container my-4 flex-grow-1">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="mb-0"><%= app_name %> — アップロードしたCSVは一時ファイルとして処理され、データベースには保存されません。</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
